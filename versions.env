# Single source of truth for the tool pins used by the example/parity scripts.
# Sourced by: co-noir/co-noir/examples/{compare.sh,compare_mpc.sh,compile.sh}
# and test_vectors/noir/compile.sh; quoted by co-noir/co-noir/Readme.md.
# Bump the pin HERE (one-line diff) instead of editing each script.
NARGO_VERSION=1.0.0-beta.22
BARRETENBERG_VERSION=5.0.0-nightly.20260708
# THE parity oracle: bb source-built at $BARRETENBERG_VERSION (PROVENANCE.txt
# lives beside the binary; a source-built bb prints a placeholder --version).
# Prebuilt release binaries are NOT trustworthy oracles: a release binary can
# predate the tag's tree (the 5.0.0-rc.2 lesson).
BARRETENBERG_BINARY_DEFAULT="$HOME/.bb-target-src/bb"
