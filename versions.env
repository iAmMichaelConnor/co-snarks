# Exact toolchain used by the UltraHonk interoperability tests.
# Noir is the final 1.0.0 release. Aztec v6.0.0 itself pins Noir v1.0.0-rc.3
# (5a7ee9bf); the later release candidates and 1.0.0 keep the same ACIR format.
NARGO_VERSION=1.0.0
NARGO_COMMIT=275d3ab1a5c916c6ea73e8d6b943f685f574500c
BARRETENBERG_VERSION=6.0.0
BARRETENBERG_COMMIT=0219f11d8133970df3974fe5ae65e006bf8c193a
# Source-built binaries report a placeholder version. Check PROVENANCE.txt
# beside the binary against BARRETENBERG_COMMIT, rather than its version text.
BARRETENBERG_BINARY_DEFAULT="$HOME/.bb-target-src-v6.0.0/bb"
